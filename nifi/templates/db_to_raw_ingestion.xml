<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<template encoding-version="1.3">
    <description>Standard Data Ingestion Flow: DB to Raw JSON</description>
    <groupId>f3b890f1-0182-1000-8438-2d8544d62211</groupId>
    <name>DB_to_Raw_Ingestion</name>
    <snippet>
        <processGroups>
            <id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</id>
            <name>PostgreSQL_Ingestion</name>
            <contents>
                <processors>
                    <id>p1</id>
                    <name>QueryDatabaseTable</name>
                    <type>org.apache.nifi.processors.standard.QueryDatabaseTable</type>
                    <config>
                        <properties>
                            <entry><key>Database Connection Pool</key><value>PostgresPool</value></entry>
                            <entry><key>Table Name</key><value>customers</value></entry>
                        </properties>
                    </config>
                </processors>
                <processors>
                    <id>p2</id>
                    <name>ConvertAvroToJSON</name>
                    <type>org.apache.nifi.processors.avro.ConvertAvroToJSON</type>
                </processors>
                <processors>
                    <id>p3</id>
                    <name>PutFile</name>
                    <type>org.apache.nifi.processors.standard.PutFile</type>
                    <config>
                        <properties>
                            <entry><key>Directory</key><value>/opt/nifi/nifi-current/data/raw/customers</value></entry>
                        </properties>
                    </config>
                </processors>
            </contents>
        </processGroups>
    </snippet>
</template>
