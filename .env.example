# Database Credentials
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_password
POSTGRES_DB=transactional_db
POSTGRES_PORT=5432

MYSQL_USER=admin
MYSQL_PASSWORD=admin_password
MYSQL_DATABASE=billing_db
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3306

MONGODB_USER=admin
MONGODB_PASSWORD=admin_password
MONGODB_DATABASE=catalog_db
MONGODB_PORT=27017

CASSANDRA_USER=cassandra
CASSANDRA_PASSWORD=cassandra
CASSANDRA_KEYSPACE=events_ks
CASSANDRA_PORT=9042

# Airflow Configuration
AIRFLOW_IMAGE_NAME=apache/airflow:2.7.1
AIRFLOW_UID=1000
_PIP_ADDITIONAL_DEPENDENCIES=apache-airflow-providers-apache-spark pyspark pymongo cassandra-driver

# Airflow Fernet Key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Spark Configuration
SPARK_MASTER_PORT=7077
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=1G

# Cloud Configuration (for documentation/infrastructure testing)
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
AWS_REGION=us-east-1

GCP_PROJECT_ID=mock-project
GCP_REGION=us-central1

AZURE_SUBSCRIPTION_ID=mock-subscription
